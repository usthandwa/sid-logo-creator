=3D1.0">
    <title>SID Logo Creator - Quick Reference</title>
   =20


    <div class=3D"page">
        <header>
            <h1>=F0=9F=8E=A8 Logo Creator Quick Reference</h1>
            <p class=3D"subtitle">SID Adventist Logo Creator - One-Page Che=
at Sheet</p>
        </header>

        <div class=3D"content">
            <!-- Left Column -->
            <div class=3D"column">
                <!-- Getting Started -->
                <section>
                    <h2>=F0=9F=9A=80 Getting Started</h2>
                    <h3>The 6 Quick Steps:</h3>
                    <div class=3D"step-flow">
                        <div class=3D"step">1</div> Organization type
                    </div>
                    <div class=3D"step-flow">
                        <div class=3D"step">2</div> Choose language
                    </div>
                    <div class=3D"step-flow">
                        <div class=3D"step">3</div> Pick layout
                    </div>
                    <div class=3D"step-flow">
                        <div class=3D"step">4</div> Enter name
                    </div>
                    <div class=3D"step-flow">
                        <div class=3D"step">5</div> Select color
                    </div>
                    <div class=3D"step-flow">
                        <div class=3D"step">6</div> Download
                    </div>
                </section>

                <!-- Organization Types -->
                <section>
                    <h2>=F0=9F=8F=A2 Organization Types</h2>
                    <h3>Church</h3>
                    <p>Local congregation. Supports full names and descript=
ors.</p>
                    <h3>Conference</h3>
                    <p>Regional body. Standard layouts available.</p>
                    <h3>Union</h3>
                    <p>Large multi-regional. Enhanced options.</p>
                    <h3>Institution</h3>
                    <p>Schools, hospitals. Sector-specific styling.</p>
                </section>

                <!-- Languages -->
                <section>
                    <h2>=F0=9F=8C=8D Language Status</h2>
                    <h3>=E2=9C=85 Approved Languages</h3>
                    <p>Verified &amp; ready to publish. Use for official wo=
rk.</p>
                    <h3>=F0=9F=93=8B Staged Languages</h3>
                    <p>Drafts awaiting approval. Review use only.</p>
                    <div class=3D"critical">
                        =E2=9A=A0=EF=B8=8F Never publish staged language lo=
gos!
                    </div>
                </section>

                <!-- Layouts -->
                <section>
                    <h2>=F0=9F=93=90 Layout Options</h2>
                    <h3>=E2=86=94=EF=B8=8F Horizontal (Lateral)</h3>
                    <p>Symbol left, text right. Wide format, professional.<=
/p>
                    <h3>=E2=86=95=EF=B8=8F Vertical (Stacked)</h3>
                    <p>Symbol top, text below. Social media friendly.</p>
                    <h3>=E2=9A=AB Symbol Only</h3>
                    <p>Mark only. Favicons, badges, small uses.</p>
                </section>

                <!-- Text Entry -->
                <section>
                    <h2>=E2=9C=8F=EF=B8=8F Text Fields</h2>
                    <h3>Entity Name</h3>
                    <p>Main text in logo. Use official name exactly.</p>
                    <h3>Descriptor</h3>
                    <p>Optional second line. Smaller text below name.</p>
                    <div class=3D"tip-box">
                        =F0=9F=92=A1 Leave entity name blank for base logo =
with denomination only.
                    </div>
                </section>
            </div>

            <!-- Right Column -->
            <div class=3D"column">
                <!-- Download Formats -->
                <section>
                    <h2>=F0=9F=92=BE Download Formats</h2>
                    <table class=3D"format-table">
                        <tbody><tr>
                            <td>PNG</td>
                            <td>Web, social media, presentations</td>
                        </tr>
                        <tr>
                            <td>SVG</td>
                            <td>Professional print, unlimited scaling</td>
                        </tr>
                        <tr>
                            <td>PDF</td>
                            <td>Print shops, archiving</td>
                        </tr>
                    </tbody></table>
                    <div class=3D"tip-box">
                        =E2=9C=93 Download SVG first. It's best for profess=
ional use and never loses quality.
                    </div>
                </section>

                <!-- Size Requirements -->
                <section>
                    <h2>=F0=9F=93=8F Size Requirements</h2>
                    <div class=3D"logo-sizes">
                        <strong>Print:</strong> Minimum 30mm wide
                    </div>
                    <div class=3D"logo-sizes">
                        <strong>Screen:</strong> Minimum 180px wide
                    </div>
                    <div class=3D"critical">
                        Never reproduce smaller than these limits!
                    </div>
                </section>

                <!-- Clear Space -->
                <section>
                    <h2>=F0=9F=94=B2 Clear Space</h2>
                    <p>Empty area around logo (2x lowercase height).</p>
                    <h3>Crop Tight</h3>
                    <p>No extra space. Smaller file size.</p>
                    <h3>Include Clear Space</h3>
                    <p>Adds protection space. Recommended for professional =
use.</p>
                </section>

                <!-- Preview Background -->
                <section>
                    <h2>=F0=9F=91=80 Preview Only</h2>
                    <p>Background color is for preview only. It will NOT be=
 included in your downloaded file.</p>
                </section>

                <!-- Do's & Don'ts -->
                <section>
                    <h2>=E2=9C=93 Do's &amp; =E2=9C=97 Don'ts</h2>
                    <div class=3D"checklist">
                        <div class=3D"checklist-item">
                            <div class=3D"checkbox"></div>
                            <div>=E2=9C=93 Use approved languages</div>
                        </div>
                        <div class=3D"checklist-item">
                            <div class=3D"checkbox"></div>
                            <div>=E2=9C=93 Download SVG for pro use</div>
                        </div>
                        <div class=3D"checklist-item">
                            <div class=3D"checkbox"></div>
                            <div>=E2=9C=93 Follow size minimums</div>
                        </div>
                        <div class=3D"checklist-item">
                            <div class=3D"checkbox"></div>
                            <div>=E2=9C=97 Don't edit after download</div>
                        </div>
                        <div class=3D"checklist-item">
                            <div class=3D"checkbox"></div>
                            <div>=E2=9C=97 Don't change colors/spacing</div=
>
                        </div>
                        <div class=3D"checklist-item">
                            <div class=3D"checkbox"></div>
                            <div>=E2=9C=97 Don't use staged languages</div>
                        </div>
                    </div>
                </section>

                <!-- Brand Reference -->
                <section>
                    <h2>=F0=9F=8E=A8 Brand Resources</h2>
                    <h3>Official Source</h3>
                    <p><strong>adventist.design</strong> =E2=80=94 Complete=
 identity system</p>
                    <h3>Support</h3>
                    <p>Contact: SID Communication</p>
                    <h3>Colors</h3>
                    <p>All provided colors are officially approved.</p>
                </section>

                <!-- Language Lab -->
                <section>
                    <h2>=F0=9F=94=AC Language Lab</h2>
                    <p>Tab for testing new languages.</p>
                    <h3>Features:</h3>
                    <ul>
                        <li>View staged languages</li>
                        <li>Filter by union</li>
                        <li>Activate with unlock code</li>
                        <li>Test in Creator</li>
                        <li>Browser-only (no publishing)</li>
                    </ul>
                </section>
            </div>
        </div>

        <footer>
            <p>SID Adventist Logo Creator =E2=80=A2 Official Seventh-day Ad=
ventist Church branding =E2=80=A2 Print or save this page as PDF for quick =
reference</p>
        </footer>
    </div>


</body></html>
